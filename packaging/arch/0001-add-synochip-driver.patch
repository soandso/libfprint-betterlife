+
+#pragma once
+
+#include "fpi-device.h"
+#include "fpi-ssm.h"
+
+G_DECLARE_FINAL_TYPE (FpiDeviceSynochip, fpi_device_synochip, FPI, DEVICE_SYNOCHIP, FpDevice)
+
+#define SYNO_DRIVER_FULLNAME     "SynoData / Synochip Fingerprint Reader"
+
+#define SYNO_EP_OUT              (0x01 | FPI_USB_ENDPOINT_OUT)
+#define SYNO_EP_IN               (0x81 | FPI_USB_ENDPOINT_IN)
+#define SYNO_USB_INTERFACE       0
+#define SYNO_USB_PACKET          64
+#define SYNO_CMD_TIMEOUT         5000   /* ms */
+#define SYNO_POLL_INTERVAL       30     /* ms between finger-detect polls */
+
+/* Outer frame: EF 01 <type> 00 <len LE16> ; reply header <type> <st> <len LE16> */
+#define SYNO_FRAME_MAGIC0        0xEF
+#define SYNO_FRAME_MAGIC1        0x01
+#define SYNO_FRAME_TYPE_APDU     0xFE
+#define SYNO_FRAME_ST_MORE       0xFE   /* reply status: more chunks follow */
+
+/* APDU layer: FE <INS> <P1> <P2> [Lc data] [Le]; reply ends with SW1 SW2 */
+#define SYNO_CLA                 0xFE
+#define SYNO_INS_CAPTURE         0x01
+#define SYNO_INS_INIT            0x30
+#define SYNO_INS_DETECT          0x32
