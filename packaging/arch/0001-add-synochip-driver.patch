+/*
+ * SynoData / Hangzhou Synochip match-on-chip USB fingerprint reader (2f50:0100)
+ * Sold as "Blasoul Fingerprint Reader".
+ *
+ * Copyright (C) 2026 libfprint-synochip contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ *
+ * Protocol (reverse engineered for interoperability, see libfprint-synochip docs/PROTOCOL.md):
+ *
+ *   host -> dev : EF 01 FE 00 <len LE16>      followed by the APDU as a separate bulk write
+ *   dev -> host : FE <st> <len LE16>          followed by <len> bytes; repeated while st == 0xFE
+ *   APDU        : FE <INS> <P1> <P2> [Lc data] [Le]; the reply ends with SW1 SW2
+ *                 (90 00 = OK, 69 xx = error xx)
+ *
+ * The device does enrollment, template storage and matching itself. Each enrolled
+ * template is keyed on the device by an ASCII "SID" string (Windows uses the
+ * account SID); we use the libfprint print user-id. Identification (INS 0x55)
+ * returns the 32-byte template hash generated at enrollment time, which is what
+ * we keep in the print's fpi-data together with the SID.
+ */
+
+#define FP_COMPONENT "synochip"
+
+#include "drivers_api.h"
+#include "synochip.h"
+
+struct _FpiDeviceSynochip
+{
+  FpDevice   parent;
+
+  FpiSsm    *task_ssm;
+  FpiSsm    *cmd_ssm;
+
+  /* current command exchange */
+  GByteArray *cmd_apdu;
+  GByteArray *resp;
+  guint16     chunk_len;
+  guint8      chunk_st;
+
+  /* enroll state */
+  guint8      enroll_progress;
+  gint        enroll_stage;
+  gint        enroll_touches;
+  gchar      *enroll_sid;
+};
+
+G_DEFINE_TYPE (FpiDeviceSynochip, fpi_device_synochip, FP_TYPE_DEVICE)
+
+static const FpIdEntry id_table[] = {
+  { .vid = 0x2f50, .pid = 0x0100, },
+  { .vid = 0,      .pid = 0,      .driver_data = 0 },
+};
+
+/* ------------------------------------------------------------------------- */
+/* Command transport                                                          */
+/* ------------------------------------------------------------------------- */
+
+typedef void (*SynoCmdCallback) (FpiDeviceSynochip *self,
+                                 guint16            sw,
+                                 const guint8      *data,
+                                 gsize              data_len,
+                                 GError            *error);
+
+typedef enum {
+  CMD_SEND_HEADER,
+  CMD_SEND_APDU,
+  CMD_RECV_HEADER,
+  CMD_RECV_DATA,
+  CMD_NUM_STATES,
+} SynoCmdState;
+
+static void
+cmd_recv_header_cb (FpiUsbTransfer *transfer,
+                    FpDevice       *dev,
+                    gpointer        user_data,
+                    GError         *error)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  if (transfer->actual_length != 4)
+    {
+      fpi_ssm_mark_failed (transfer->ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                     "Unexpected reply header length %zd",
+                                                     transfer->actual_length));
+      return;
+    }
+
+  self->chunk_st = transfer->buffer[1];
+  self->chunk_len = transfer->buffer[2] | (transfer->buffer[3] << 8);
+
+  if (self->chunk_len == 0)
+    {
+      if (self->chunk_st == SYNO_FRAME_ST_MORE)
+        fpi_ssm_jump_to_state (transfer->ssm, CMD_RECV_HEADER);
+      else
+        fpi_ssm_mark_completed (transfer->ssm);
+      return;
+    }
+
+  fpi_ssm_next_state (transfer->ssm);
+}
+
+static void
+cmd_recv_data_cb (FpiUsbTransfer *transfer,
+                  FpDevice       *dev,
+                  gpointer        user_data,
+                  GError         *error)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  g_byte_array_append (self->resp, transfer->buffer,
+                       MIN ((gsize) transfer->actual_length, self->chunk_len));
+
+  if ((gsize) transfer->actual_length < self->chunk_len)
+    {
+      /* Data arrived in more than one transfer; read the remainder */
+      self->chunk_len -= transfer->actual_length;
+      fpi_ssm_jump_to_state (transfer->ssm, CMD_RECV_DATA);
+      return;
+    }
+
+  if (self->chunk_st == SYNO_FRAME_ST_MORE)
+    fpi_ssm_jump_to_state (transfer->ssm, CMD_RECV_HEADER);
+  else
+    fpi_ssm_mark_completed (transfer->ssm);
+}
+
+static void
+cmd_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+  FpiUsbTransfer *transfer;
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case CMD_SEND_HEADER:
+      transfer = fpi_usb_transfer_new (dev);
+      fpi_usb_transfer_fill_bulk (transfer, SYNO_EP_OUT, 6);
+      transfer->buffer[0] = SYNO_FRAME_MAGIC0;
+      transfer->buffer[1] = SYNO_FRAME_MAGIC1;
+      transfer->buffer[2] = SYNO_FRAME_TYPE_APDU;
+      transfer->buffer[3] = 0x00;
+      transfer->buffer[4] = self->cmd_apdu->len & 0xff;
+      transfer->buffer[5] = (self->cmd_apdu->len >> 8) & 0xff;
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_submit (transfer, SYNO_CMD_TIMEOUT, NULL,
+                               fpi_ssm_usb_transfer_cb, NULL);
+      break;
+
+    case CMD_SEND_APDU:
+      transfer = fpi_usb_transfer_new (dev);
+      fpi_usb_transfer_fill_bulk (transfer, SYNO_EP_OUT, self->cmd_apdu->len);
+      memcpy (transfer->buffer, self->cmd_apdu->data, self->cmd_apdu->len);
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_submit (transfer, SYNO_CMD_TIMEOUT, NULL,
+                               fpi_ssm_usb_transfer_cb, NULL);
+      break;
+
+    case CMD_RECV_HEADER:
+      transfer = fpi_usb_transfer_new (dev);
+      fpi_usb_transfer_fill_bulk (transfer, SYNO_EP_IN, SYNO_USB_PACKET);
+      transfer->ssm = ssm;
+      fpi_usb_transfer_submit (transfer, SYNO_CMD_TIMEOUT, NULL,
+                               cmd_recv_header_cb, NULL);
+      break;
+
+    case CMD_RECV_DATA:
+      transfer = fpi_usb_transfer_new (dev);
+      /* round up to whole packets so a full-size final packet never overflows */
+      fpi_usb_transfer_fill_bulk (transfer, SYNO_EP_IN,
+                                  ((self->chunk_len + SYNO_USB_PACKET - 1) / SYNO_USB_PACKET) * SYNO_USB_PACKET);
+      transfer->ssm = ssm;
+      fpi_usb_transfer_submit (transfer, SYNO_CMD_TIMEOUT, NULL,
+                               cmd_recv_data_cb, NULL);
+      break;
+    }
+}
+
+static void
+cmd_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+  SynoCmdCallback callback = fpi_ssm_get_data (ssm);
+  guint16 sw;
+
+  self->cmd_ssm = NULL;
+  g_clear_pointer (&self->cmd_apdu, g_byte_array_unref);
+
+  if (error)
+    {
+      g_clear_pointer (&self->resp, g_byte_array_unref);
+      callback (self, 0, NULL, 0, error);
+      return;
+    }
+
+  if (self->resp->len < 2)
+    {
+      g_clear_pointer (&self->resp, g_byte_array_unref);
+      callback (self, 0, NULL, 0,
+                fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                          "Reply too short for a status word"));
+      return;
+    }
+
+  sw = (self->resp->data[self->resp->len - 2] << 8) | self->resp->data[self->resp->len - 1];
+  fp_dbg ("SW %04x, %u data bytes", sw, self->resp->len - 2);
+
+  {
+    g_autoptr(GByteArray) resp = g_steal_pointer (&self->resp);
+    callback (self, sw, resp->data, resp->len - 2, NULL);
+  }
+}
+
+/*
+ * SAFETY: only these instructions may ever be sent to the device.
+ * INS 0x1A (vendor "SY2_N_Clear") switched a unit into a different firmware
+ * personality (USB 2008:7639, "SY09 V02.04") that could not be recovered.
+ * Everything not listed here is refused before it reaches USB.
+ */
+static const guint8 syno_allowed_ins[] = {
+  SYNO_INS_CAPTURE, SYNO_INS_INIT, SYNO_INS_DETECT, SYNO_INS_ENROLL_STEP,
+  SYNO_INS_ENROLL_FINISH, SYNO_INS_UID_BY_SID, SYNO_INS_IDENTIFY,
+  SYNO_INS_ENROLL_CHECK, SYNO_INS_CHECK_VALID, SYNO_INS_DELETE_ALL,
+};
+
+G_STATIC_ASSERT (SYNO_INS_CAPTURE != 0x1A && SYNO_INS_INIT != 0x1A && SYNO_INS_DETECT != 0x1A &&
+                 SYNO_INS_ENROLL_STEP != 0x1A && SYNO_INS_ENROLL_FINISH != 0x1A &&
+                 SYNO_INS_UID_BY_SID != 0x1A && SYNO_INS_IDENTIFY != 0x1A &&
+                 SYNO_INS_ENROLL_CHECK != 0x1A && SYNO_INS_CHECK_VALID != 0x1A &&
+                 SYNO_INS_DELETE_ALL != 0x1A);
+
+static gboolean
+syno_apdu_allowed (const guint8 *apdu, gsize apdu_len)
+{
+  gsize i;
+
+  if (apdu_len < 4 || apdu[0] != SYNO_CLA)
+    return FALSE;
+  /* delete-all is only allowed in the exact form the Windows driver uses */
+  if (apdu[1] == SYNO_INS_DELETE_ALL)
+    return apdu_len == 4 && apdu[2] == 0x00 && apdu[3] == 0x00;
+  for (i = 0; i < G_N_ELEMENTS (syno_allowed_ins); i++)
+    if (apdu[1] == syno_allowed_ins[i])
+      return TRUE;
+  return FALSE;
+}
+
+/* Send one APDU; callback gets the status word and the data that preceded it. */
+static void
+syno_cmd (FpiDeviceSynochip *self,
+          const guint8      *apdu,
+          gsize              apdu_len,
+          SynoCmdCallback    callback)
+{
+  g_assert (self->cmd_ssm == NULL);
+
+  if (!syno_apdu_allowed (apdu, apdu_len))
+    {
+      g_critical ("synochip: refusing to send non-allowlisted APDU (INS 0x%02x)",
+                  apdu_len > 1 ? apdu[1] : 0);
+      callback (self, 0, NULL, 0,
+                fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                          "Refused unsafe command"));
+      return;
+    }
+
+  self->cmd_apdu = g_byte_array_sized_new (apdu_len);
+  g_byte_array_append (self->cmd_apdu, apdu, apdu_len);
+  self->resp = g_byte_array_new ();
+
+  self->cmd_ssm = fpi_ssm_new (FP_DEVICE (self), cmd_run_state, CMD_NUM_STATES);
+  fpi_ssm_silence_debug (self->cmd_ssm);
+  fpi_ssm_set_data (self->cmd_ssm, callback, NULL);
+  fpi_ssm_start (self->cmd_ssm, cmd_ssm_done);
+}
+
+static GError *
+syno_sw_error (guint16 sw, const char *what)
+{
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                   "%s failed with status %04x", what, sw);
+}
+
+static GError *
+syno_full_error (void)
+{
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_FULL,
+                                   "Reader storage is full (%d users). Delete all prints "
+                                   "(fprintd-delete) so the chip is cleared before the next enrollment",
+                                   SYNO_MAX_USERS);
+}
+
+static gboolean
+syno_cancelled (FpDevice *dev)
+{
+  GCancellable *c = fpi_device_get_cancellable (dev);
+
+  return c && g_cancellable_is_cancelled (c);
+}
+
+/* Generic callbacks for the task state machines ---------------------------- */
+
+static void
+task_cmd_expect_ok_cb (FpiDeviceSynochip *self, guint16 sw,
+                       const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw != SYNO_SW_OK)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_sw_error (sw, "Command"));
+      return;
+    }
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+/* "wait for finger": poll INS 0x32 until 90 00 */
+static void
+task_wait_finger_cb (FpiDeviceSynochip *self, guint16 sw,
+                     const guint8 *data, gsize len, GError *error)
+{
+  FpDevice *dev = FP_DEVICE (self);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  if (sw == SYNO_SW_OK)
+    {
+      fpi_device_report_finger_status_changes (dev, FP_FINGER_STATUS_PRESENT,
+                                               FP_FINGER_STATUS_NEEDED);
+      fpi_ssm_next_state (self->task_ssm);
+      return;
+    }
+
+  if (sw >> 8 == SYNO_SW1_ERR &&
+      ((sw & 0xff) == SYNO_ERR_NO_FINGER || (sw & 0xff) == SYNO_ERR_STATE))
+    {
+      if (syno_cancelled (dev))
+        {
+          fpi_ssm_mark_failed (self->task_ssm,
+                               g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                                    "Cancelled"));
+          return;
+        }
+      fpi_ssm_jump_to_state_delayed (self->task_ssm,
+                                     fpi_ssm_get_cur_state (self->task_ssm),
+                                     SYNO_POLL_INTERVAL);
+      return;
+    }
+
+  fpi_ssm_mark_failed (self->task_ssm, syno_sw_error (sw, "Finger detect"));
+}
+
+/* "wait for lift": poll INS 0x32 until 69 02 */
+static void
+task_wait_lift_cb (FpiDeviceSynochip *self, guint16 sw,
+                   const guint8 *data, gsize len, GError *error)
+{
+  FpDevice *dev = FP_DEVICE (self);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  if (sw == SYNO_SW_OK)
+    {
+      if (syno_cancelled (dev))
+        {
+          fpi_ssm_mark_failed (self->task_ssm,
+                               g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                                    "Cancelled"));
+          return;
+        }
+      fpi_ssm_jump_to_state_delayed (self->task_ssm,
+                                     fpi_ssm_get_cur_state (self->task_ssm),
+                                     SYNO_POLL_INTERVAL);
+      return;
+    }
+
+  fpi_device_report_finger_status_changes (dev, FP_FINGER_STATUS_NONE,
+                                           FP_FINGER_STATUS_PRESENT);
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static const guint8 apdu_init[] = { SYNO_CLA, SYNO_INS_INIT, 0x00, 0x00 };
+static const guint8 apdu_detect[] = { SYNO_CLA, SYNO_INS_DETECT, 0x00, 0x00 };
+static const guint8 apdu_capture[] = { SYNO_CLA, SYNO_INS_CAPTURE, 0x01, 0x00, 0x01, 0x01, 0x04 };
+static const guint8 apdu_enroll_step[] = { SYNO_CLA, SYNO_INS_ENROLL_STEP, 0x00, 0x00, 0x01 };
+static const guint8 apdu_enroll_check[] = { SYNO_CLA, SYNO_INS_ENROLL_CHECK, 0x00, 0x00, 0x01 };
+/* record FFFF = search all stored records (Windows sent 0001 because its record was #1) */
+static const guint8 apdu_identify[] = { SYNO_CLA, SYNO_INS_IDENTIFY, 0x00, 0x00, 0x02, 0xFF, 0xFF, 0x25 };
+
+static void
+task_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  self->task_ssm = NULL;
+  g_clear_pointer (&self->enroll_sid, g_free);
+
+  if (error)
+    fpi_device_action_error (dev, error);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Print data helpers                                                         */
+/* ------------------------------------------------------------------------- */
+
+/* fpi-data = (ay sid, ay hash) */
+static gboolean
+print_get_hash (FpPrint *print, const guint8 **hash)
+{
+  g_autoptr(GVariant) data = NULL;
+  g_autoptr(GVariant) sid_var = NULL;
+  g_autoptr(GVariant) hash_var = NULL;
+  gsize hash_len = 0;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_check_format_string (data, "(@ay@ay)", FALSE))
+    return FALSE;
+
+  g_variant_get (data, "(@ay@ay)", &sid_var, &hash_var);
+  *hash = g_variant_get_fixed_array (hash_var, &hash_len, 1);
+  if (hash_len != SYNO_HASH_LEN)
+    return FALSE;
+
+  /* The variant children are owned by `data`, which the print keeps alive. */
+  return TRUE;
+}
+
+static gboolean
+print_matches_hash (FpPrint *print, const guint8 *hash)
+{
+  const guint8 *stored;
+
+  if (!print_get_hash (print, &stored))
+    return FALSE;
+
+  return memcmp (stored, hash, SYNO_HASH_LEN) == 0;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Enroll                                                                     */
+/* ------------------------------------------------------------------------- */
+
+typedef enum {
+  ENROLL_INIT,
+  ENROLL_COUNT,
+  ENROLL_WAIT_FINGER,
+  ENROLL_CAPTURE,
+  ENROLL_STEP,
+  ENROLL_WAIT_LIFT,
+  ENROLL_LOOP,
+  ENROLL_CHECK_VALID,
+  ENROLL_CHECK,
+  ENROLL_UID_BY_SID,
+  ENROLL_FINISH,
+  ENROLL_NUM_STATES,
+} SynoEnrollState;
+
+static void
+enroll_retry (FpiDeviceSynochip *self, FpDeviceRetry retry)
+{
+  fpi_device_enroll_progress (FP_DEVICE (self), self->enroll_stage, NULL,
+                              fpi_device_retry_new (retry));
+  fpi_ssm_jump_to_state (self->task_ssm, ENROLL_WAIT_LIFT);
+}
+
+static void
+enroll_capture_cb (FpiDeviceSynochip *self, guint16 sw,
+                   const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  self->enroll_touches++;
+  if (sw != SYNO_SW_OK)
+    {
+      fp_dbg ("Capture failed (%04x), asking for retry", sw);
+      enroll_retry (self, FP_DEVICE_RETRY_CENTER_FINGER);
+      return;
+    }
+
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+enroll_step_cb (FpiDeviceSynochip *self, guint16 sw,
+                const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  if (sw != SYNO_SW_OK || len < 1)
+    {
+      fp_dbg ("Enroll step rejected (%04x)", sw);
+      if (self->enroll_touches >= SYNO_MAX_ENROLL_TOUCHES)
+        {
+          fpi_ssm_mark_failed (self->task_ssm,
+                               fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                                         "Too many failed enroll touches"));
+          return;
+        }
+      enroll_retry (self, FP_DEVICE_RETRY_GENERAL);
+      return;
+    }
+
+  if (data[0] > self->enroll_progress)
+    {
+      self->enroll_progress = data[0];
+      self->enroll_stage = MIN (self->enroll_stage + 1, SYNO_NR_ENROLL_STAGES - 1);
+      if (self->enroll_progress >= SYNO_ENROLL_DONE)
+        self->enroll_stage = SYNO_NR_ENROLL_STAGES;
+      fp_dbg ("Enroll progress %u%% (stage %d)", self->enroll_progress, self->enroll_stage);
+      fpi_device_enroll_progress (FP_DEVICE (self), self->enroll_stage, NULL, NULL);
+    }
+  else
+    {
+      /* accepted but no progress (too similar to a previous touch) */
+      fpi_device_enroll_progress (FP_DEVICE (self), self->enroll_stage, NULL,
+                                  fpi_device_retry_new (FP_DEVICE_RETRY_CENTER_FINGER));
+    }
+
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+enroll_finish_cb (FpiDeviceSynochip *self, guint16 sw,
+                  const guint8 *data, gsize len, GError *error)
+{
+  FpDevice *dev = FP_DEVICE (self);
+  FpPrint *print = NULL;
+  GVariant *sid_var, *hash_var;
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw == ((SYNO_SW1_ERR << 8) | SYNO_ERR_FULL))
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_full_error ());
+      return;
+    }
+  if (sw != SYNO_SW_OK || len < SYNO_HASH_LEN)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_sw_error (sw, "Enroll finish"));
+      return;
+    }
+
+  fpi_device_get_enroll_data (dev, &print);
+
+  sid_var = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, self->enroll_sid,
+                                       strlen (self->enroll_sid), 1);
+  hash_var = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, data, SYNO_HASH_LEN, 1);
+
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("(@ay@ay)", sid_var, hash_var), NULL);
+  g_object_set (print, "description", self->enroll_sid, NULL);
+
+  fp_info ("Enrolled print %s", self->enroll_sid);
+  fpi_device_enroll_complete (dev, g_object_ref (print), NULL);
+  fpi_ssm_mark_completed (self->task_ssm);
+}
+
+/* Refuse before the user starts tapping if the chip has no free user slot */
+static void
+enroll_count_cb (FpiDeviceSynochip *self, guint16 sw,
+                 const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw == SYNO_SW_OK && len >= 1)
+    {
+      fp_dbg ("Users stored on chip before enroll: %u", data[0]);
+      if (data[0] >= SYNO_MAX_USERS)
+        {
+          fpi_ssm_mark_failed (self->task_ssm, syno_full_error ());
+          return;
+        }
+    }
+  else
+    {
+      fp_dbg ("User count answered %04x (ignored)", sw);
+    }
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+enroll_uid_by_sid_cb (FpiDeviceSynochip *self, guint16 sw,
+                      const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw == ((SYNO_SW1_ERR << 8) | SYNO_ERR_FULL))
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_full_error ());
+      return;
+    }
+  /* Windows sends this lookup before finishing; we only log the answer */
+  if (sw == SYNO_SW_OK && len >= 2)
+    fp_dbg ("UID for SID before enroll: %u", (data[0] << 8) | data[1]);
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+enroll_lenient_cb (FpiDeviceSynochip *self, guint16 sw,
+                   const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw != SYNO_SW_OK)
+    fp_dbg ("Pre-finish command answered %04x (ignored)", sw);
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+enroll_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case ENROLL_INIT:
+      syno_cmd (self, apdu_init, sizeof (apdu_init), task_cmd_expect_ok_cb);
+      break;
+
+    case ENROLL_COUNT:
+      syno_cmd (self, apdu_enroll_check, sizeof (apdu_enroll_check), enroll_count_cb);
+      break;
+
+    case ENROLL_WAIT_FINGER:
+      if (self->enroll_progress >= SYNO_ENROLL_DONE)
+        {
+          fpi_ssm_jump_to_state (ssm, ENROLL_CHECK_VALID);
+          return;
+        }
+      fpi_device_report_finger_status_changes (dev, FP_FINGER_STATUS_NEEDED,
+                                               FP_FINGER_STATUS_NONE);
+      syno_cmd (self, apdu_detect, sizeof (apdu_detect), task_wait_finger_cb);
+      break;
+
+    case ENROLL_CAPTURE:
+      syno_cmd (self, apdu_capture, sizeof (apdu_capture), enroll_capture_cb);
+      break;
+
+    case ENROLL_STEP:
+      syno_cmd (self, apdu_enroll_step, sizeof (apdu_enroll_step), enroll_step_cb);
+      break;
+
+    case ENROLL_WAIT_LIFT:
+      syno_cmd (self, apdu_detect, sizeof (apdu_detect), task_wait_lift_cb);
+      break;
+
+    case ENROLL_LOOP:
+      /* WAIT_FINGER moves on to CHECK_VALID once progress reaches 100% */
+      fpi_ssm_jump_to_state (ssm, ENROLL_WAIT_FINGER);
+      break;
+
+    case ENROLL_CHECK_VALID:
+      {
+        guint8 apdu[5 + 32 + 1] = { SYNO_CLA, SYNO_INS_CHECK_VALID, 0x00, 0x00, 0x20 };
+        guint i;
+
+        for (i = 0; i < 32; i += 4)
+          {
+            guint32 r = g_random_int_range (0, 0x8000);   /* Windows sends small LE u32s */
+            apdu[5 + i] = r & 0xff;
+            apdu[6 + i] = (r >> 8) & 0xff;
+          }
+        apdu[37] = 0x20;
+        syno_cmd (self, apdu, sizeof (apdu), enroll_lenient_cb);
+        break;
+      }
+
+    case ENROLL_CHECK:
+      syno_cmd (self, apdu_enroll_check, sizeof (apdu_enroll_check), enroll_lenient_cb);
+      break;
+
+    case ENROLL_UID_BY_SID:
+      {
+        guint8 apdu[5 + 2 + SYNO_SID_FIELD_LEN + 1] = { 0 };
+        gsize sid_len = strlen (self->enroll_sid);
+
+        apdu[0] = SYNO_CLA;
+        apdu[1] = SYNO_INS_UID_BY_SID;
+        apdu[4] = 2 + SYNO_SID_FIELD_LEN;
+        apdu[5] = (sid_len >> 8) & 0xff;
+        apdu[6] = sid_len & 0xff;
+        memcpy (apdu + 7, self->enroll_sid, sid_len);
+        apdu[sizeof (apdu) - 1] = 0x02;
+        syno_cmd (self, apdu, sizeof (apdu), enroll_uid_by_sid_cb);
+        break;
+      }
+
+    case ENROLL_FINISH:
+      {
+        guint8 apdu[5 + 4 + SYNO_SID_FIELD_LEN + 1] = { 0 };
+        gsize sid_len = strlen (self->enroll_sid);
+
+        apdu[0] = SYNO_CLA;
+        apdu[1] = SYNO_INS_ENROLL_FINISH;
+        apdu[4] = 4 + SYNO_SID_FIELD_LEN;
+        apdu[5] = 0x00;
+        apdu[6] = 0x00;
+        apdu[7] = (SYNO_SUBFACTOR >> 8) & 0xff;
+        apdu[8] = SYNO_SUBFACTOR & 0xff;
+        memcpy (apdu + 9, self->enroll_sid, sid_len);
+        apdu[sizeof (apdu) - 1] = SYNO_HASH_LEN;
+        syno_cmd (self, apdu, sizeof (apdu), enroll_finish_cb);
+        break;
+      }
+    }
+}
+
+static void
+synochip_enroll (FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+  FpPrint *print = NULL;
+  g_autofree gchar *user_id = NULL;
+
+  fpi_device_get_enroll_data (dev, &print);
+  user_id = fpi_print_generate_user_id (print);
+  if (strlen (user_id) >= SYNO_SID_FIELD_LEN)
+    user_id[SYNO_SID_FIELD_LEN - 1] = '\0';
+
+  self->enroll_sid = g_steal_pointer (&user_id);
+  self->enroll_progress = 0;
+  self->enroll_stage = 0;
+  self->enroll_touches = 0;
+
+  self->task_ssm = fpi_ssm_new (dev, enroll_run_state, ENROLL_NUM_STATES);
+  fpi_ssm_start (self->task_ssm, task_ssm_done);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Verify / Identify                                                          */
+/* ------------------------------------------------------------------------- */
+
+typedef enum {
+  MATCH_INIT,
+  MATCH_WAIT_FINGER,
+  MATCH_CAPTURE,
+  MATCH_IDENTIFY,
+  MATCH_NUM_STATES,
+} SynoMatchState;
+
+static void
+match_report (FpiDeviceSynochip *self, const guint8 *hash, GError *retry)
+{
+  FpDevice *dev = FP_DEVICE (self);
+
+  if (fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_VERIFY)
+    {
+      FpPrint *print = NULL;
+      FpiMatchResult result;
+
+      fpi_device_get_verify_data (dev, &print);
+      if (retry)
+        result = FPI_MATCH_ERROR;
+      else if (hash && print_matches_hash (print, hash))
+        result = FPI_MATCH_SUCCESS;
+      else
+        result = FPI_MATCH_FAIL;
+
+      fpi_device_verify_report (dev, result, NULL, retry);
+      fpi_device_verify_complete (dev, NULL);
+    }
+  else
+    {
+      GPtrArray *prints = NULL;
+      FpPrint *match = NULL;
+      guint i;
+
+      fpi_device_get_identify_data (dev, &prints);
+      for (i = 0; hash && !retry && i < prints->len; i++)
+        {
+          if (print_matches_hash (g_ptr_array_index (prints, i), hash))
+            {
+              match = g_ptr_array_index (prints, i);
+              break;
+            }
+        }
+
+      fpi_device_identify_report (dev, match, NULL, retry);
+      fpi_device_identify_complete (dev, NULL);
+    }
+}
+
+static void
+match_capture_cb (FpiDeviceSynochip *self, guint16 sw,
+                  const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw != SYNO_SW_OK)
+    {
+      fp_dbg ("Capture failed (%04x)", sw);
+      match_report (self, NULL, fpi_device_retry_new (FP_DEVICE_RETRY_CENTER_FINGER));
+      fpi_ssm_mark_completed (self->task_ssm);
+      return;
+    }
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+match_identify_cb (FpiDeviceSynochip *self, guint16 sw,
+                   const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  fpi_device_report_finger_status_changes (FP_DEVICE (self), FP_FINGER_STATUS_NONE,
+                                           FP_FINGER_STATUS_PRESENT);
+
+  if (sw == SYNO_SW_OK && len >= 5 + SYNO_HASH_LEN)
+    {
+      /* <id BE16> <subfactor BE16> <flag> <hash 32> */
+      fp_dbg ("Device match: id %u subfactor %04x", (data[0] << 8) | data[1],
+              (data[2] << 8) | data[3]);
+      match_report (self, data + 5, NULL);
+    }
+  else if (sw == ((SYNO_SW1_ERR << 8) | SYNO_ERR_NO_MATCH))
+    {
+      match_report (self, NULL, NULL);
+    }
+  else if (sw == ((SYNO_SW1_ERR << 8) | SYNO_ERR_BAD_IMAGE) ||
+           sw == ((SYNO_SW1_ERR << 8) | SYNO_ERR_STATE))
+    {
+      match_report (self, NULL, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+    }
+  else
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_sw_error (sw, "Identify"));
+      return;
+    }
+
+  fpi_ssm_mark_completed (self->task_ssm);
+}
+
+static void
+match_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case MATCH_INIT:
+      syno_cmd (self, apdu_init, sizeof (apdu_init), task_cmd_expect_ok_cb);
+      break;
+
+    case MATCH_WAIT_FINGER:
+      fpi_device_report_finger_status_changes (dev, FP_FINGER_STATUS_NEEDED,
+                                               FP_FINGER_STATUS_NONE);
+      syno_cmd (self, apdu_detect, sizeof (apdu_detect), task_wait_finger_cb);
+      break;
+
+    case MATCH_CAPTURE:
+      syno_cmd (self, apdu_capture, sizeof (apdu_capture), match_capture_cb);
+      break;
+
+    case MATCH_IDENTIFY:
+      syno_cmd (self, apdu_identify, sizeof (apdu_identify), match_identify_cb);
+      break;
+    }
+}
+
+static void
+synochip_match (FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  self->task_ssm = fpi_ssm_new (dev, match_run_state, MATCH_NUM_STATES);
+  fpi_ssm_start (self->task_ssm, task_ssm_done);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Storage: clear / delete                                                    */
+/* ------------------------------------------------------------------------- */
+
+/*
+ * The chip has no per-template delete that we can drive: the Windows engine
+ * deletes single users with INS 0x57, but that needs the full list of SIDs to
+ * keep, which a libfprint driver does not know. So:
+ *   clear_storage: FE 45 00 00 (delete all), then verify the user count is 0.
+ *   delete:        reads the user count and leaves the template on the chip.
+ *                  It can no longer authenticate (matching compares against the
+ *                  hash kept in fprintd's print), and fprintd clears storage
+ *                  before the next first enrollment, as the Windows driver does.
+ */
+
+typedef enum {
+  STORE_INIT,
+  STORE_DELETE_ALL,
+  STORE_COUNT,
+  STORE_NUM_STATES,
+} SynoStoreState;
+
+static const guint8 apdu_delete_all[] = { SYNO_CLA, SYNO_INS_DELETE_ALL, 0x00, 0x00 };
+static const guint8 apdu_user_count[] = { SYNO_CLA, SYNO_INS_USER_COUNT, 0x00, 0x00, 0x01 };
+
+static void
+store_delete_all_cb (FpiDeviceSynochip *self, guint16 sw,
+                     const guint8 *data, gsize len, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw != SYNO_SW_OK)
+    {
+      fpi_ssm_mark_failed (self->task_ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                     "Device rejected delete-all (status %04x)",
+                                                     sw));
+      return;
+    }
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+store_count_cb (FpiDeviceSynochip *self, guint16 sw,
+                const guint8 *data, gsize len, GError *error)
+{
+  FpDevice *dev = FP_DEVICE (self);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+  if (sw != SYNO_SW_OK || len < 1)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, syno_sw_error (sw, "User count"));
+      return;
+    }
+
+  fp_dbg ("Users stored on chip: %u", data[0]);
+
+  if (fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_CLEAR_STORAGE)
+    {
+      if (data[0] != 0)
+        {
+          fpi_ssm_mark_failed (self->task_ssm,
+                               fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                         "%u users still stored after delete-all",
+                                                         data[0]));
+          return;
+        }
+    }
+  else if (data[0] != 0)
+    {
+      fp_info ("Print removed from the host only: its template stays on the chip "
+               "(%u users stored) until storage is cleared", data[0]);
+    }
+
+  fpi_ssm_mark_completed (self->task_ssm);
+}
+
+static void
+store_run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case STORE_INIT:
+      syno_cmd (self, apdu_init, sizeof (apdu_init), task_cmd_expect_ok_cb);
+      break;
+
+    case STORE_DELETE_ALL:
+      if (fpi_device_get_current_action (dev) != FPI_DEVICE_ACTION_CLEAR_STORAGE)
+        {
+          fpi_ssm_next_state (ssm);
+          return;
+        }
+      syno_cmd (self, apdu_delete_all, sizeof (apdu_delete_all), store_delete_all_cb);
+      break;
+
+    case STORE_COUNT:
+      syno_cmd (self, apdu_user_count, sizeof (apdu_user_count), store_count_cb);
+      break;
+    }
+}
+
+static void
+store_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  self->task_ssm = NULL;
+
+  if (error)
+    {
+      fpi_device_action_error (dev, error);
+      return;
+    }
+
+  if (fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_CLEAR_STORAGE)
+    fpi_device_clear_storage_complete (dev, NULL);
+  else
+    fpi_device_delete_complete (dev, NULL);
+}
+
+static void
+synochip_storage_op (FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  self->task_ssm = fpi_ssm_new (dev, store_run_state, STORE_NUM_STATES);
+  fpi_ssm_start (self->task_ssm, store_ssm_done);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Open / close                                                               */
+/* ------------------------------------------------------------------------- */
+
+static void
+open_init_cb (FpiDeviceSynochip *self, guint16 sw,
+              const guint8 *data, gsize len, GError *error)
+{
+  FpDevice *dev = FP_DEVICE (self);
+
+  if (!error && sw != SYNO_SW_OK)
+    error = syno_sw_error (sw, "Init");
+
+  if (error)
+    g_usb_device_release_interface (fpi_device_get_usb_device (dev),
+                                    SYNO_USB_INTERFACE, 0, NULL);
+
+  fpi_device_open_complete (dev, error);
+}
+
+static void
+synochip_open (FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+  GError *error = NULL;
+
+  if (!g_usb_device_claim_interface (fpi_device_get_usb_device (dev),
+                                     SYNO_USB_INTERFACE, 0, &error))
+    {
+      fpi_device_open_complete (dev, error);
+      return;
+    }
+
+  syno_cmd (self, apdu_init, sizeof (apdu_init), open_init_cb);
+}
+
+static void
+synochip_close (FpDevice *dev)
+{
+  GError *error = NULL;
+
+  g_usb_device_release_interface (fpi_device_get_usb_device (dev),
+                                  SYNO_USB_INTERFACE, 0, &error);
+  fpi_device_close_complete (dev, error);
+}
+
+static void
+synochip_cancel (FpDevice *dev)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (dev);
+
+  /* Pending finger polls are delayed state changes; the poll callbacks
+   * notice the cancellable. Nothing else is long-running. */
+  if (self->task_ssm)
+    fp_dbg ("Cancel requested");
+}
+
+static void
+fpi_device_synochip_init (FpiDeviceSynochip *self)
+{
+}
+
+static void
+fpi_device_synochip_finalize (GObject *object)
+{
+  FpiDeviceSynochip *self = FPI_DEVICE_SYNOCHIP (object);
+
+  g_clear_pointer (&self->enroll_sid, g_free);
+  G_OBJECT_CLASS (fpi_device_synochip_parent_class)->finalize (object);
+}
+
+static void
+fpi_device_synochip_class_init (FpiDeviceSynochipClass *klass)
+{
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (klass);
+  GObjectClass *obj_class = G_OBJECT_CLASS (klass);
+
+  obj_class->finalize = fpi_device_synochip_finalize;
+
+  dev_class->id = FP_COMPONENT;
+  dev_class->full_name = SYNO_DRIVER_FULLNAME;
+  dev_class->type = FP_DEVICE_TYPE_USB;
+  dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+  dev_class->id_table = id_table;
+  dev_class->nr_enroll_stages = SYNO_NR_ENROLL_STAGES;
+  dev_class->temp_hot_seconds = -1;
+
+  dev_class->open = synochip_open;
+  dev_class->close = synochip_close;
+  dev_class->enroll = synochip_enroll;
+  dev_class->verify = synochip_match;
+  dev_class->identify = synochip_match;
+  dev_class->cancel = synochip_cancel;
+  dev_class->delete = synochip_storage_op;
+  dev_class->clear_storage = synochip_storage_op;
+
+  fpi_device_class_auto_initialize_features (dev_class);
+}
