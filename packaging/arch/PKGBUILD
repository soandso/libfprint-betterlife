# Maintainer: libfprint-betterlife
# Based on Arch Linux's libfprint PKGBUILD (Jan Alexander Steffens et al.)
# Upstream libfprint v1.94.100 + drivers for the SynoData/Synochip 2f50:0100 reader
# (from libfprint-synochip) and the Betterlife 347d:0302 module.

pkgname=libfprint-btl-syno
_pkgname=libfprint
pkgver=1.94.100
pkgrel=4
pkgdesc="Library for fingerprint readers (with Synochip 2f50:0100 and Betterlife 347d:0302 drivers)"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint libfprint-synochip)
replaces=(libfprint-synochip)
groups=(fprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=v$pkgver"
        "0001-add-synochip-driver.patch"
        "0002-add-betterlife-driver.patch")
b2sums=('SKIP'
        'b96e2eb2e2fecf801a0c89e229c5948d58af27e2e9cefec45db90e31028b3451c0dc9f74274a2346131efc191c8d2ebf59b94486d1dc6f06206c872f6eb04e7f'
        '32a3cc8da2fe7a4baa766e74e0bdaa5dcedf9800faa2d90b5fe24993d0ebf90ccffc47a3adf2ab44a2dce3e9be1e0ab658cc5cdd9d055e0442dde67f78540cdd')

prepare() {
  cd $_pkgname
  git apply "$srcdir/0001-add-synochip-driver.patch"
  git apply "$srcdir/0002-add-betterlife-driver.patch"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson $_pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
