# Maintainer: soandso <585980+soandso@users.noreply.github.com>
# Based on Arch Linux's libfprint PKGBUILD (Jan Alexander Steffens et al.)
#
# libfprint + an out-of-tree driver for the Betterlife / BLESTECH 347d:0302 match-on-chip USB
# fingerprint reader: https://github.com/soandso/libfprint-betterlife
# Unofficial; developed with AI assistance (see the project's docs/VALIDATION.md).

pkgname=libfprint-betterlife
_pkgname=libfprint
pkgver=1.94.100
_drvver=0.1.0
pkgrel=1
pkgdesc="Library for fingerprint readers, with a driver for the Betterlife 347d:0302 reader"
url="https://github.com/soandso/libfprint-betterlife"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=v$pkgver"
        "0001-add-betterlife-driver-$_drvver.patch::https://github.com/soandso/libfprint-betterlife/releases/download/v$_drvver/0001-add-betterlife-driver.patch")
b2sums=('SKIP'
        '6d1c3dafb2472820111774c1e5411f22a437405869dc51ac98475742bd20d72c349128337f80dc23e40275eecdf0c7d998ec652e2f8efb44d7c00b9153873701')

prepare() {
  cd $_pkgname
  git apply "$srcdir/0001-add-betterlife-driver-$_drvver.patch"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson $_pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
